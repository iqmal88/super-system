datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ClassRoom {
  id        String   @id @default(cuid())
  name      String   @unique
  students  Student[]
  createdAt DateTime @default(now())
}

model Student {
  id           String       @id @default(cuid())
  studentId    String       @unique
  name         String
  classRoomId  String
  classRoom    ClassRoom    @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
}

model Club {
  id          String       @id @default(cuid())
  name        String       @unique
  maxCapacity Int          @default(30)
  enrollments Enrollment[]
}

model Admin {
  id       String @id @default(cuid())
  username String @unique
  password String // In a production banking app you'd hash this, but for a simple school app we'll keep it plain for now
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  clubId    String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([studentId, clubId]) // Prevents duplicate assignment of the same student to the same club
}