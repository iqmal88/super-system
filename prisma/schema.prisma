datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id       String @id @default(cuid())
  username String @unique
  password String
}

model ClassRoom {
  id       String    @id @default(cuid())
  name     String    @unique // e.g., "1 Amanah", "2 Bestari"
  form     String    // e.g., "Form 1", "Form 2"
  students Student[]
}

model Student {
  id          String           @id @default(cuid())
  studentId   String           @unique
  name        String
  classRoomId String
  classRoom   ClassRoom        @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  assignments ClubAssignment[]
}

model Club {
  id          String           @id @default(cuid())
  name        String           @unique // e.g., "Pengakap", "Kelab Bola Sepak"
  category    String           // e.g., "Uniform Body", "Academic", "Sports"
  assignments ClubAssignment[]
}

model ClubAssignment {
  id        String   @id @default(cuid())
  studentId String
  clubId    String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([studentId, clubId]) // Prevents duplicate assignment of the same student to the same club
}